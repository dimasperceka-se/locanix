# Copy to .env and fill in. Never commit the real .env.

# PayPal app credentials (all from the same environment).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Fill after registering the public /api/paypal/webhook URL in PayPal.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PLAN_REGULAR_ID=
PAYPAL_PLAN_PRO_ID=
# Local browser return URL; use your HTTPS site origin in production.
PAYPAL_RETURN_BASE=http://localhost:3001

# Public base URL — used to build email links (verification). No trailing slash.
APP_URL=https://locanix.id

# Session cookie signing secret — use a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL — stores every uploaded plot
DATABASE_URL=postgres://locanix:CHANGE_ME@localhost:5432/locanix

# EUDR analysis backend (FastAPI) — root only; the app appends /api/v1/<type>
ANALYSIS_API_BASE=https://global-compliance-system.com

# Brevo SMTP (account verification emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-brevo-login
SMTP_KEY=your-brevo-smtp-key
SMTP_FROM=Locanix <no-reply@locanix.id>
